<div class="mb-8">
  <%= link_to "← #{@dataset.name}", project_dataset_path(@project, @dataset), class: 'text-sm text-gray-400 hover:text-gray-300' %>
  <h1 class="text-2xl font-bold text-white mt-2">Edit Example #<%= @example.id %></h1>
</div>

<div class="max-w-3xl">
  <%= form_with model: [@project, @dataset, @example], class: 'space-y-6' do |f| %>
    <div class="bg-gray-800/50 rounded-lg border border-gray-700 p-6">
      <label class="block text-sm font-medium text-gray-300 mb-2">Messages (JSON)</label>
      <%= f.text_area :messages, value: JSON.pretty_generate(@example.messages), rows: 20, class: 'w-full rounded-md bg-gray-900 border border-gray-700 px-3 py-2 text-white font-mono text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent' %>
      <p class="mt-2 text-xs text-gray-500">Edit the messages array as JSON. Must be a valid array of message objects with "role" and "content" fields.</p>
    </div>
    <div class="flex items-center gap-3">
      <%= f.submit 'Save', class: 'px-4 py-2 rounded-md bg-indigo-600 text-sm font-semibold text-white hover:bg-indigo-500 cursor-pointer' %>
      <%= link_to 'Cancel', project_dataset_path(@project, @dataset), class: 'px-4 py-2 text-sm text-gray-400 hover:text-white' %>
    </div>
  <% end %>
</div>
