<div class="mb-6">
  <div class="flex items-center gap-3 mb-1">
    <%= link_to @project.name, project_path(@project), class: 'text-sm text-gray-400 hover:text-gray-300' %>
    <span class="text-gray-600">/</span>
    <span class="text-sm text-gray-400">Datasets</span>
  </div>
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-4">
      <h1 class="text-2xl font-bold text-white"><%= @dataset.name %></h1>
      <%= status_badge(@dataset.status) %>
    </div>
    <div class="flex items-center gap-2">
      <% if @dataset.ready? %>
        <%= link_to 'New Experiment', new_project_training_run_path(@project, dataset_id: @dataset.id), class: 'px-3 py-1.5 rounded-md bg-indigo-600 text-sm font-medium text-white hover:bg-indigo-500' %>
      <% end %>
      <%= button_to 'Reprocess', process_file_project_dataset_path(@project, @dataset), method: :post, class: 'px-3 py-1.5 rounded-md border border-gray-700 text-sm text-gray-300 hover:border-gray-500 hover:text-white' %>
    </div>
  </div>
</div>

<!-- Stats -->
<div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-8">
  <div class="bg-gray-800/50 rounded-lg border border-gray-700 p-4">
    <p class="text-xs text-gray-500 uppercase tracking-wider">Total</p>
    <p class="text-2xl font-bold text-white mt-1"><%= number_with_delimiter(@dataset.examples_count) %></p>
  </div>
  <div class="bg-gray-800/50 rounded-lg border border-gray-700 p-4">
    <p class="text-xs text-gray-500 uppercase tracking-wider">Accepted</p>
    <p class="text-2xl font-bold text-green-400 mt-1"><%= number_with_delimiter(@dataset.accepted_count) %></p>
  </div>
  <div class="bg-gray-800/50 rounded-lg border border-gray-700 p-4">
    <p class="text-xs text-gray-500 uppercase tracking-wider">Rejected</p>
    <p class="text-2xl font-bold text-red-400 mt-1"><%= number_with_delimiter(@dataset.rejected_count) %></p>
  </div>
  <div class="bg-gray-800/50 rounded-lg border border-gray-700 p-4">
    <p class="text-xs text-gray-500 uppercase tracking-wider">Needs Review</p>
    <p class="text-2xl font-bold text-yellow-400 mt-1"><%= number_with_delimiter(@dataset.needs_review_count) %></p>
  </div>
  <div class="bg-gray-800/50 rounded-lg border border-gray-700 p-4">
    <p class="text-xs text-gray-500 uppercase tracking-wider">Errors</p>
    <p class="text-2xl font-bold text-red-400 mt-1"><%= number_with_delimiter(@dataset.with_errors_count) %></p>
  </div>
</div>

<!-- Filters -->
<div class="flex items-center gap-2 mb-6">
  <% [['all', 'All'], ['accepted', 'Accepted'], ['rejected', 'Rejected'], ['needs_review', 'Needs Review'], ['errors', 'Errors']].each do |value, label| %>
    <%= link_to label, project_dataset_path(@project, @dataset, filter: value),
        class: "px-3 py-1.5 text-sm rounded-md #{@filter == value ? 'bg-indigo-600 text-white' : 'bg-gray-800 text-gray-400 hover:text-white border border-gray-700'}" %>
  <% end %>
</div>

<!-- Bulk Actions -->
<% if @examples.any? %>
  <%= form_with url: bulk_action_project_dataset_dataset_examples_path(@project, @dataset), method: :post, id: 'bulk-form', data: { controller: 'bulk-select' } do |f| %>
    <div class="flex items-center gap-2 mb-4">
      <label class="flex items-center gap-2 text-sm text-gray-400 cursor-pointer">
        <input type="checkbox" data-action="change->bulk-select#toggleAll" data-bulk-select-target="selectAll" class="rounded bg-gray-800 border-gray-600">
        Select all
      </label>
      <div class="flex gap-2 ml-4" data-bulk-select-target="actions" style="display: none;">
        <button type="submit" name="bulk_action" value="accept" class="px-2 py-1 text-xs rounded bg-green-900/50 text-green-300 border border-green-700 hover:bg-green-900">Accept Selected</button>
        <button type="submit" name="bulk_action" value="reject" class="px-2 py-1 text-xs rounded bg-red-900/50 text-red-300 border border-red-700 hover:bg-red-900">Reject Selected</button>
        <button type="submit" name="bulk_action" value="delete" class="px-2 py-1 text-xs rounded bg-red-900/50 text-red-300 border border-red-700 hover:bg-red-900" data-confirm="Delete selected examples?">Delete Selected</button>
      </div>
    </div>

    <!-- Examples -->
    <div class="space-y-3">
      <% @examples.each do |example| %>
        <div class="bg-gray-800/50 rounded-lg border border-gray-700 p-4" id="<%= dom_id(example) %>">
          <div class="flex items-start gap-3">
            <input type="checkbox" name="example_ids[]" value="<%= example.id %>" data-action="change->bulk-select#toggleOne" data-bulk-select-target="checkbox" class="mt-1 rounded bg-gray-800 border-gray-600">
            <div class="flex-1">
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2">
                  <span class="text-xs text-gray-500">#<%= example.id %></span>
                  <% if example.accepted? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-900/50 text-green-300 border border-green-700">Accepted</span>
                  <% elsif example.rejected? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-900/50 text-red-300 border border-red-700">Rejected</span>
                  <% else %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-900/50 text-yellow-300 border border-yellow-700">Needs Review</span>
                  <% end %>
                  <% if example.has_validation_errors? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-900/50 text-red-300 border border-red-700">Validation Errors</span>
                  <% end %>
                </div>
                <div class="flex items-center gap-1">
                  <%= button_to 'Accept', accept_project_dataset_dataset_example_path(@project, @dataset, example), method: :post, class: 'px-2 py-1 text-xs rounded bg-green-900/30 text-green-400 hover:bg-green-900/50 border border-green-800' %>
                  <%= button_to 'Reject', reject_project_dataset_dataset_example_path(@project, @dataset, example), method: :post, class: 'px-2 py-1 text-xs rounded bg-red-900/30 text-red-400 hover:bg-red-900/50 border border-red-800' %>
                  <%= link_to 'Edit', edit_project_dataset_dataset_example_path(@project, @dataset, example), class: 'px-2 py-1 text-xs rounded bg-gray-700 text-gray-300 hover:bg-gray-600' %>
                  <%= button_to 'Delete', project_dataset_dataset_example_path(@project, @dataset, example), method: :delete, class: 'px-2 py-1 text-xs rounded bg-red-900/30 text-red-400 hover:bg-red-900/50 border border-red-800', data: { turbo_confirm: 'Delete this example?' } %>
                </div>
              </div>

              <!-- Chat messages -->
              <div class="space-y-2">
                <% example.conversation_messages.each do |msg| %>
                  <div class="flex gap-3">
                    <div class="flex-shrink-0">
                      <% if msg['role'] == 'user' %>
                        <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-blue-900/50 text-blue-300 text-xs font-medium">U</span>
                      <% elsif msg['role'] == 'assistant' %>
                        <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-purple-900/50 text-purple-300 text-xs font-medium">A</span>
                      <% else %>
                        <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-gray-700 text-gray-300 text-xs font-medium">S</span>
                      <% end %>
                    </div>
                    <div class="flex-1">
                      <p class="text-xs font-medium text-gray-400 mb-0.5"><%= msg['role']&.capitalize %></p>
                      <p class="text-sm text-gray-200 whitespace-pre-wrap"><%= msg['content'] %></p>
                    </div>
                  </div>
                <% end %>
              </div>

              <% if example.has_validation_errors? %>
                <div class="mt-3 bg-red-900/20 rounded p-2">
                  <p class="text-xs text-red-400 font-medium mb-1">Validation Errors:</p>
                  <ul class="list-disc list-inside text-xs text-red-300">
                    <% Array(example.validation_errors).each do |error| %>
                      <li><%= error %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- Pagination -->
  <%= render 'shared/pagination' %>
<% else %>
  <div class="text-center py-12 bg-gray-800/30 rounded-lg border border-gray-700 border-dashed">
    <p class="text-sm text-gray-500">
      <% if @dataset.processing? %>
        Dataset is being processed...
      <% else %>
        No examples match this filter.
      <% end %>
    </p>
  </div>
<% end %>
