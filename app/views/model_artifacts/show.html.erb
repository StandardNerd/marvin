<div class="mb-8">
  <%= link_to '← Artifacts', project_model_artifacts_path(@project), class: 'text-sm text-gray-400 hover:text-gray-300' %>
  <div class="flex justify-between items-start mt-2">
    <div>
      <h1 class="text-2xl font-bold text-white"><%= @artifact.name %></h1>
      <p class="text-sm text-gray-400 mt-1">Version: <%= @artifact.version %></p>
    </div>
    <div>
      <%= link_to 'Download Adapter', download_project_model_artifact_path(@project, @artifact), class: 'px-4 py-2 rounded-md bg-indigo-600 text-sm font-medium text-white hover:bg-indigo-500' %>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  <div class="bg-gray-800/50 rounded-lg border border-gray-700 p-6 space-y-4">
    <h3 class="text-lg font-semibold text-white border-b border-gray-700 pb-2">Details</h3>
    <dl class="space-y-2 text-sm">
      <div class="flex justify-between">
        <dt class="text-gray-500">Base Model</dt>
        <dd class="text-white font-mono"><%= @artifact.base_model %></dd>
      </div>
      <div class="flex justify-between">
        <dt class="text-gray-500">Training Run</dt>
        <dd class="text-white"><%= link_to @artifact.training_run.name, project_training_run_path(@project, @artifact.training_run), class: 'text-indigo-400' %></dd>
      </div>
      <div class="flex justify-between">
        <dt class="text-gray-500">Created At</dt>
        <dd class="text-white"><%= @artifact.created_at.strftime('%Y-%m-%d %H:%M') %></dd>
      </div>
    </dl>
  </div>
  
  <div class="bg-gray-800/50 rounded-lg border border-gray-700 p-6">
    <h3 class="text-lg font-semibold text-white border-b border-gray-700 pb-2 mb-4">Description</h3>
    <div class="text-sm text-gray-300 whitespace-pre-wrap"><%= @artifact.description.presence || 'No description provided.' %></div>
  </div>
</div>
