<div class="flex items-center justify-between mb-8">
  <h1 class="text-2xl font-bold text-white">Model Artifacts</h1>
  <%= link_to 'Register Artifact', new_project_model_artifact_path(@project), class: 'inline-flex items-center px-4 py-2 rounded-md bg-indigo-600 text-sm font-semibold text-white hover:bg-indigo-500' %>
</div>

<% if @artifacts.any? %>
  <div class="bg-gray-800/50 rounded-lg border border-gray-700 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-700">
      <thead class="bg-gray-800">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Name</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Version</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Base Model</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Training Run</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Created</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-700/50">
        <% @artifacts.each do |artifact| %>
          <tr class="hover:bg-gray-700/30">
            <td class="px-4 py-3"><%= link_to artifact.name, project_model_artifact_path(@project, artifact), class: 'text-indigo-400 hover:text-indigo-300 font-medium' %></td>
            <td class="px-4 py-3 text-sm text-gray-300"><%= artifact.version %></td>
            <td class="px-4 py-3 text-sm text-gray-300 font-mono"><%= artifact.base_model %></td>
            <td class="px-4 py-3 text-sm text-gray-300"><%= link_to artifact.training_run.name, project_training_run_path(@project, artifact.training_run), class: 'text-indigo-400 hover:text-indigo-300' %></td>
            <td class="px-4 py-3 text-sm text-gray-400"><%= time_ago_in_words(artifact.created_at) %> ago</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="text-center py-16 bg-gray-800/30 rounded-lg border border-gray-700 border-dashed">
    <p class="text-sm text-gray-500">No model artifacts yet. Train a model and register its adapter.</p>
  </div>
<% end %>
