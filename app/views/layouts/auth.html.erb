<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-950">
<head>
  <title>QLoRA Experiment Studio</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body class="h-full bg-gray-950">
  <div class="flex min-h-full items-center justify-center px-4 py-12 sm:px-6 lg:px-8">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <h1 class="text-2xl font-bold text-white flex items-center justify-center gap-2">
          <svg class="w-8 h-8 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          QLoRA Experiment Studio
        </h1>
        <p class="mt-2 text-sm text-gray-400">Fine-tune LLMs with QLoRA</p>
      </div>

      <% if alert %>
        <div class="rounded-md bg-red-900/50 border border-red-700 p-4 mb-6">
          <p class="text-sm text-red-300"><%= alert %></p>
        </div>
      <% end %>

      <% if notice %>
        <div class="rounded-md bg-green-900/50 border border-green-700 p-4 mb-6">
          <p class="text-sm text-green-300"><%= notice %></p>
        </div>
      <% end %>

      <div class="bg-gray-900 rounded-lg border border-gray-800 p-8">
        <%= yield %>
      </div>
    </div>
  </div>
</body>
</html>
