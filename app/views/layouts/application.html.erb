<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-950">
<head>
  <title>QLoRA Experiment Studio</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body class="h-full bg-gray-950 text-gray-100">
  <div class="min-h-full">
    <!-- Navigation -->
    <nav class="bg-gray-900 border-b border-gray-800">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-14 items-center justify-between">
          <div class="flex items-center gap-8">
            <%= link_to root_path, class: "flex items-center gap-2 text-white font-semibold text-lg" do %>
              <svg class="w-6 h-6 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              QLoRA Studio
            <% end %>
            <% if logged_in? %>
              <div class="hidden md:flex items-center gap-1">
                <%= link_to 'Projects', projects_path, class: "px-3 py-2 rounded-md text-sm font-medium #{request.path.start_with?('/projects') ? 'bg-gray-800 text-white' : 'text-gray-300 hover:bg-gray-800 hover:text-white'}" %>
                <%= link_to 'Experiments', experiments_path, class: "px-3 py-2 rounded-md text-sm font-medium #{request.path.start_with?('/experiments') ? 'bg-gray-800 text-white' : 'text-gray-300 hover:bg-gray-800 hover:text-white'}" %>
              </div>
            <% end %>
          </div>
          <% if logged_in? %>
            <div class="flex items-center gap-4">
              <span class="text-sm text-gray-400"><%= current_user.name %></span>
              <%= button_to 'Sign out', logout_path, method: :delete, class: "text-sm text-gray-400 hover:text-white" %>
            </div>
          <% end %>
        </div>
      </div>
    </nav>

    <!-- Flash messages -->
    <% if notice %>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mt-4">
        <div class="rounded-md bg-green-900/50 border border-green-700 p-4">
          <p class="text-sm text-green-300"><%= notice %></p>
        </div>
      </div>
    <% end %>
    <% if alert %>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mt-4">
        <div class="rounded-md bg-red-900/50 border border-red-700 p-4">
          <p class="text-sm text-red-300"><%= alert %></p>
        </div>
      </div>
    <% end %>

    <!-- Main content -->
    <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>
  </div>
</body>
</html>
