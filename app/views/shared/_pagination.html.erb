<% if @pagy && @pagy.pages > 1 %>
  <nav class="flex items-center justify-between border-t border-gray-700 px-2 py-4 mt-6">
    <div class="text-sm text-gray-400">
      Showing <%= @pagy.from %>-<%= @pagy.to %> of <%= @pagy.count %>
    </div>
    <div class="flex gap-1">
      <% if @pagy.prev %>
        <%= link_to 'Previous', url_for(page: @pagy.prev), class: 'px-3 py-1.5 text-sm rounded bg-gray-800 text-gray-300 hover:bg-gray-700 border border-gray-700' %>
      <% end %>
      <% @pagy.series.each do |item| %>
        <% if item.is_a?(Integer) %>
          <%= link_to item, url_for(page: item), class: 'px-3 py-1.5 text-sm rounded bg-gray-800 text-gray-300 hover:bg-gray-700 border border-gray-700' %>
        <% elsif item.is_a?(String) %>
          <span class="px-3 py-1.5 text-sm rounded bg-indigo-600 text-white border border-indigo-500"><%= item %></span>
        <% elsif item == :gap %>
          <span class="px-3 py-1.5 text-sm text-gray-500">…</span>
        <% end %>
      <% end %>
      <% if @pagy.next %>
        <%= link_to 'Next', url_for(page: @pagy.next), class: 'px-3 py-1.5 text-sm rounded bg-gray-800 text-gray-300 hover:bg-gray-700 border border-gray-700' %>
      <% end %>
    </div>
  </nav>
<% end %>
