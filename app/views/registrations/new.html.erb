<h2 class="text-xl font-semibold text-white mb-6">Create account</h2>

<%= form_with model: @user, url: signup_path, class: "space-y-5" do |f| %>
  <% if @user.errors.any? %>
    <div class="rounded-md bg-red-900/50 border border-red-700 p-4">
      <ul class="list-disc list-inside text-sm text-red-300">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-300 mb-1" %>
    <%= f.text_field :name, autofocus: true, required: true, class: "w-full rounded-md bg-gray-800 border border-gray-700 px-3 py-2 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
  </div>

  <div>
    <%= f.label :email, class: "block text-sm font-medium text-gray-300 mb-1" %>
    <%= f.email_field :email, required: true, class: "w-full rounded-md bg-gray-800 border border-gray-700 px-3 py-2 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
  </div>

  <div>
    <%= f.label :password, class: "block text-sm font-medium text-gray-300 mb-1" %>
    <%= f.password_field :password, required: true, class: "w-full rounded-md bg-gray-800 border border-gray-700 px-3 py-2 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
  </div>

  <div>
    <%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-300 mb-1" %>
    <%= f.password_field :password_confirmation, required: true, class: "w-full rounded-md bg-gray-800 border border-gray-700 px-3 py-2 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
  </div>

  <div>
    <%= f.submit 'Create account', class: "w-full rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 cursor-pointer" %>
  </div>
<% end %>

<p class="mt-6 text-center text-sm text-gray-400">
  Already have an account?
  <%= link_to 'Sign in', login_path, class: "text-indigo-400 hover:text-indigo-300" %>
</p>
