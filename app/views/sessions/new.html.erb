<h2 class="text-xl font-semibold text-white mb-6">Sign in</h2>

<%= form_with url: login_path, class: "space-y-5" do |f| %>
  <div>
    <%= f.label :email, class: "block text-sm font-medium text-gray-300 mb-1" %>
    <%= f.email_field :email, autofocus: true, required: true, class: "w-full rounded-md bg-gray-800 border border-gray-700 px-3 py-2 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
  </div>

  <div>
    <%= f.label :password, class: "block text-sm font-medium text-gray-300 mb-1" %>
    <%= f.password_field :password, required: true, class: "w-full rounded-md bg-gray-800 border border-gray-700 px-3 py-2 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent" %>
  </div>

  <div>
    <%= f.submit 'Sign in', class: "w-full rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 cursor-pointer" %>
  </div>
<% end %>

<p class="mt-6 text-center text-sm text-gray-400">
  Don't have an account?
  <%= link_to 'Sign up', signup_path, class: "text-indigo-400 hover:text-indigo-300" %>
</p>
