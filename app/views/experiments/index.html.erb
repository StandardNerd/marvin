<div class="flex items-center justify-between mb-8">
  <h1 class="text-2xl font-bold text-white">All Experiments</h1>
</div>

<% if @training_runs.any? %>
  <%= form_with url: compare_experiments_path, method: :get, local: true do |f| %>
    <div class="mb-4">
      <button type="button" onclick="submitCompare()" class="px-4 py-2 rounded-md bg-indigo-600 text-sm font-medium text-white hover:bg-indigo-500">Compare Selected</button>
    </div>
    <div class="bg-gray-800/50 rounded-lg border border-gray-700 overflow-hidden">
      <table class="min-w-full divide-y divide-gray-700">
        <thead class="bg-gray-800">
          <tr>
            <th class="px-4 py-3 text-left w-10"></th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Name</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Project</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Status</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Loss</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Created</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-700/50">
          <% @training_runs.each do |run| %>
            <tr class="hover:bg-gray-700/30">
              <td class="px-4 py-3"><input type="checkbox" name="ids[]" value="<%= run.id %>" class="rounded bg-gray-800 border-gray-600"></td>
              <td class="px-4 py-3"><%= link_to run.name, project_training_run_path(run.project, run), class: 'text-indigo-400 font-medium' %></td>
              <td class="px-4 py-3 text-sm text-gray-300"><%= link_to run.project.name, project_path(run.project), class: 'hover:text-white' %></td>
              <td class="px-4 py-3"><%= status_badge(run.status) %></td>
              <td class="px-4 py-3 text-sm text-gray-300 font-mono"><%= run.latest_loss ? format('%.4f', run.latest_loss) : '—' %></td>
              <td class="px-4 py-3 text-sm text-gray-400"><%= time_ago_in_words(run.created_at) %> ago</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <script>
    function submitCompare() {
      const checkboxes = document.querySelectorAll('input[name="ids[]"]:checked');
      if (checkboxes.length > 0) {
        const ids = Array.from(checkboxes).map(cb => cb.value).join(',');
        window.location.href = "<%= compare_experiments_path %>?ids=" + ids;
      } else {
        alert("Please select at least one experiment to compare.");
      }
    }
  </script>
<% else %>
  <div class="text-center py-16 bg-gray-800/30 rounded-lg border border-gray-700 border-dashed">
    <p class="text-sm text-gray-500">No experiments found.</p>
  </div>
<% end %>
