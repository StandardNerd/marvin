<div class="mb-8">
  <%= link_to "← #{@training_run.name}", project_training_run_path(@project, @training_run), class: 'text-sm text-gray-400 hover:text-gray-300' %>
  <div class="flex items-center gap-4 mt-2">
    <h1 class="text-2xl font-bold text-white"><%= @evaluation.name %></h1>
    <span class="px-2 py-1 text-xs rounded bg-gray-700 text-gray-300"><%= @evaluation.status %></span>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  <div class="bg-gray-800/50 rounded-lg border border-gray-700 p-6">
    <h3 class="text-lg font-semibold text-white mb-4">Metrics</h3>
    <% if @evaluation.metrics.present? %>
      <div class="bg-gray-900 rounded p-4 font-mono text-sm text-gray-300 overflow-x-auto">
        <%= JSON.pretty_generate(@evaluation.metrics) %>
      </div>
    <% else %>
      <p class="text-sm text-gray-500">Evaluation is pending or running...</p>
    <% end %>
  </div>
  
  <div class="bg-gray-800/50 rounded-lg border border-gray-700 p-6">
    <h3 class="text-lg font-semibold text-white mb-4">Results</h3>
    <% if @evaluation.results.present? %>
      <div class="bg-gray-900 rounded p-4 font-mono text-sm text-gray-300 overflow-x-auto">
        <%= JSON.pretty_generate(@evaluation.results) %>
      </div>
    <% else %>
      <p class="text-sm text-gray-500">Results will appear when complete.</p>
    <% end %>
  </div>
</div>
