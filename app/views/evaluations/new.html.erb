<div class="mb-8">
  <%= link_to "← #{@training_run.name}", project_training_run_path(@project, @training_run), class: 'text-sm text-gray-400 hover:text-gray-300' %>
  <h1 class="text-2xl font-bold text-white mt-2">New Evaluation</h1>
</div>

<div class="max-w-2xl">
  <%= form_with model: [@project, @training_run, @evaluation], class: 'space-y-6' do |f| %>
    <div class="bg-gray-800/50 rounded-lg border border-gray-700 p-6 space-y-5">
      <div>
        <%= f.label :name, class: 'block text-sm font-medium text-gray-300 mb-1' %>
        <%= f.text_field :name, required: true, class: 'w-full rounded-md bg-gray-900 border border-gray-700 px-3 py-2 text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent' %>
      </div>
      <div>
        <%= f.label :eval_dataset_id, 'Evaluation Dataset', class: 'block text-sm font-medium text-gray-300 mb-1' %>
        <%= f.select :eval_dataset_id, @datasets.map { |d| [d.name, d.id] }, { include_blank: 'Select a dataset...' }, class: 'w-full rounded-md bg-gray-900 border border-gray-700 px-3 py-2 text-white focus:outline-none focus:ring-2 focus:ring-indigo-500' %>
      </div>
    </div>
    
    <div class="flex items-center gap-3">
      <%= f.submit 'Start Evaluation', class: 'px-4 py-2 rounded-md bg-indigo-600 text-sm font-semibold text-white hover:bg-indigo-500 cursor-pointer' %>
      <%= link_to 'Cancel', project_training_run_path(@project, @training_run), class: 'px-4 py-2 text-sm text-gray-400 hover:text-white' %>
    </div>
  <% end %>
</div>
