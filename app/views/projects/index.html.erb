<div class="flex items-center justify-between mb-8">
  <h1 class="text-2xl font-bold text-white">Projects</h1>
  <%= link_to 'New Project', new_project_path, class: 'inline-flex items-center px-4 py-2 rounded-md bg-indigo-600 text-sm font-semibold text-white hover:bg-indigo-500' %>
</div>

<% if @projects.any? %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <% @projects.each do |project| %>
      <%= link_to project_path(project), class: 'block bg-gray-800/50 rounded-lg border border-gray-700 p-6 hover:border-indigo-500/50 transition-colors' do %>
        <h3 class="text-lg font-semibold text-white mb-1"><%= project.name %></h3>
        <p class="text-sm text-gray-400 mb-4 line-clamp-2"><%= project.description %></p>
        <div class="flex items-center gap-4 text-xs text-gray-500">
          <span class="flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2 1 3 3 3h10c2 0 3-1 3-3V9c0-2-1-3-3-3h-4l-2-2H7c-2 0-3 1-3 3z"/></svg>
            <%= project.datasets.count %> datasets
          </span>
          <span class="flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <%= project.training_runs.count %> experiments
          </span>
        </div>
        <div class="mt-3 text-xs text-gray-500">
          <span class="font-mono"><%= project.base_model %></span>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="text-center py-16 bg-gray-800/30 rounded-lg border border-gray-700 border-dashed">
    <svg class="mx-auto h-12 w-12 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
    </svg>
    <h3 class="mt-4 text-sm font-semibold text-gray-300">No projects yet</h3>
    <p class="mt-1 text-sm text-gray-500">Get started by creating your first project.</p>
    <div class="mt-6">
      <%= link_to 'New Project', new_project_path, class: 'inline-flex items-center px-4 py-2 rounded-md bg-indigo-600 text-sm font-semibold text-white hover:bg-indigo-500' %>
    </div>
  </div>
<% end %>
