<div class="flex items-center justify-between mb-8">
  <div>
    <div class="flex items-center gap-3 mb-1">
      <%= link_to 'Projects', projects_path, class: 'text-sm text-gray-400 hover:text-gray-300' %>
      <span class="text-gray-600">/</span>
    </div>
    <h1 class="text-2xl font-bold text-white"><%= @project.name %></h1>
    <p class="text-sm text-gray-400 mt-1">Base model: <span class="font-mono text-gray-300"><%= @project.base_model %></span></p>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to 'Edit', edit_project_path(@project), class: 'px-3 py-2 text-sm text-gray-300 hover:text-white border border-gray-700 rounded-md hover:border-gray-500' %>
  </div>
</div>

<% if @project.description.present? %>
  <div class="bg-gray-800/50 rounded-lg border border-gray-700 p-4 mb-8">
    <p class="text-sm text-gray-300"><%= @project.description %></p>
  </div>
<% end %>

<!-- Datasets Section -->
<div class="mb-10">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-semibold text-white">Datasets</h2>
    <%= link_to 'Upload Dataset', new_project_dataset_path(@project), class: 'inline-flex items-center px-3 py-1.5 rounded-md bg-indigo-600 text-sm font-medium text-white hover:bg-indigo-500' %>
  </div>

  <% if @datasets.any? %>
    <div class="bg-gray-800/50 rounded-lg border border-gray-700 overflow-hidden">
      <table class="min-w-full divide-y divide-gray-700">
        <thead class="bg-gray-800">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Name</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Status</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Examples</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Created</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-700/50">
          <% @datasets.each do |dataset| %>
            <tr class="hover:bg-gray-700/30">
              <td class="px-4 py-3">
                <%= link_to dataset.name, project_dataset_path(@project, dataset), class: 'text-sm font-medium text-indigo-400 hover:text-indigo-300' %>
              </td>
              <td class="px-4 py-3"><%= status_badge(dataset.status) %></td>
              <td class="px-4 py-3 text-sm text-gray-300"><%= number_with_delimiter(dataset.examples_count) %></td>
              <td class="px-4 py-3 text-sm text-gray-400"><%= time_ago_in_words(dataset.created_at) %> ago</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-8 bg-gray-800/30 rounded-lg border border-gray-700 border-dashed">
      <p class="text-sm text-gray-500">No datasets yet. Upload a JSONL dataset to get started.</p>
    </div>
  <% end %>
</div>

<!-- Experiments Section -->
<div class="mb-10">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-lg font-semibold text-white">Experiments</h2>
    <%= link_to 'New Experiment', new_project_training_run_path(@project), class: 'inline-flex items-center px-3 py-1.5 rounded-md bg-indigo-600 text-sm font-medium text-white hover:bg-indigo-500' %>
  </div>

  <% if @training_runs.any? %>
    <div class="bg-gray-800/50 rounded-lg border border-gray-700 overflow-hidden">
      <table class="min-w-full divide-y divide-gray-700">
        <thead class="bg-gray-800">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Name</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Status</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Dataset</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Loss</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Created</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-700/50">
          <% @training_runs.each do |run| %>
            <tr class="hover:bg-gray-700/30">
              <td class="px-4 py-3">
                <%= link_to run.name, project_training_run_path(@project, run), class: 'text-sm font-medium text-indigo-400 hover:text-indigo-300' %>
              </td>
              <td class="px-4 py-3"><%= status_badge(run.status) %></td>
              <td class="px-4 py-3 text-sm text-gray-300"><%= run.dataset.name %></td>
              <td class="px-4 py-3 text-sm text-gray-300 font-mono"><%= run.latest_loss ? format('%.4f', run.latest_loss) : '—' %></td>
              <td class="px-4 py-3 text-sm text-gray-400"><%= time_ago_in_words(run.created_at) %> ago</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-8 bg-gray-800/30 rounded-lg border border-gray-700 border-dashed">
      <p class="text-sm text-gray-500">No experiments yet. Create one after uploading a dataset.</p>
    </div>
  <% end %>
</div>
