<%= form_with model: project, class: 'space-y-6' do |f| %>
  <% if project.errors.any? %>
    <div class="rounded-md bg-red-900/50 border border-red-700 p-4">
      <ul class="list-disc list-inside text-sm text-red-300">
        <% project.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-gray-800/50 rounded-lg border border-gray-700 p-6 space-y-5">
    <div>
      <%= f.label :name, class: 'block text-sm font-medium text-gray-300 mb-1' %>
      <%= f.text_field :name, required: true, class: 'w-full rounded-md bg-gray-900 border border-gray-700 px-3 py-2 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent', placeholder: 'My fine-tuning project' %>
    </div>

    <div>
      <%= f.label :description, class: 'block text-sm font-medium text-gray-300 mb-1' %>
      <%= f.text_area :description, rows: 3, class: 'w-full rounded-md bg-gray-900 border border-gray-700 px-3 py-2 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent', placeholder: 'Description of your project...' %>
    </div>

    <div>
      <%= f.label :base_model, 'Base Model', class: 'block text-sm font-medium text-gray-300 mb-1' %>
      <%= f.text_field :base_model, required: true, class: 'w-full rounded-md bg-gray-900 border border-gray-700 px-3 py-2 text-white font-mono placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent', placeholder: 'Qwen/Qwen3-8B' %>
      <p class="mt-1 text-xs text-gray-500">Hugging Face model identifier (e.g., Qwen/Qwen3-8B, meta-llama/Llama-2-7b-hf)</p>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit class: 'px-4 py-2 rounded-md bg-indigo-600 text-sm font-semibold text-white hover:bg-indigo-500 cursor-pointer' %>
    <%= link_to 'Cancel', (project.persisted? ? project_path(project) : projects_path), class: 'px-4 py-2 text-sm text-gray-400 hover:text-white' %>
  </div>
<% end %>
